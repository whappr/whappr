# Required — gates POST /api/messages and signs outgoing webhook requests.
# Generate with: openssl rand -hex 32
WHAPPR_SECRET=

# Required — inbound text messages are POSTed here.
WHAPPR_WEBHOOK_URL=

# Optional — how many seconds to buffer events before POSTing them as one batch. 0 sends each
# event immediately, with no buffering.
WHAPPR_WEBHOOK_FLUSH_INTERVAL=2

# Optional
PORT=3000
WHAPPR_SESSION_PATH=.wwebjs_auth

# Optional — minimum log severity to emit as JSON to stdout. One of: fatal, error, warn, info,
# debug, trace, silent. Each level logs itself and everything more severe; "silent" disables
# logging entirely.
LOG_LEVEL=info

# Optional — filter which events get POSTed to the webhook (see README's "Filtering which events
# are sent" section). Unset, empty, or "*" all mean "send every event". Comma-separated entries; a
# bare "type" matches that type unconditionally, "type(field=value&field2=value2)" adds
# conditions, and an entry for a specific type always takes precedence over a "*" fallback listed
# alongside it (the wildcard is not consulted for a type that has its own entry).
# WHAPPR_EVENT_FILTER=message.received(from=1555123456@c.us)
# WHAPPR_EVENT_FILTER=message.received(from=1555123456@c.us),*
