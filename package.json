{
  "name": "whappr",
  "version": "1.0.0",
  "description": "Lightweight WhatsApp gateway with a REST API. Built on whatsapp-web.js, ships as a Docker image.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/structured-logger": "^1.0.0",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.7",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "puppeteer": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
