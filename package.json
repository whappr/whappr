{
  "name": "whappr",
  "version": "1.0.0",
  "private": true,
  "description": "Whappr — WhatsApp gateway service and other related components.",
  "author": "Alexandru Bau (https://github.com/alexandrubau)",
  "license": "MIT",
  "workspaces": [
    "apps/gateway",
    "packages/client",
    "packages/flue"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "concurrently -n check,typecheck \"npm run check\" \"npm run typecheck\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.5.0",
    "concurrently": "^9.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "puppeteer": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
