{
  "name": "whappr",
  "version": "1.0.0",
  "private": true,
  "description": "Whappr monorepo — WhatsApp gateway service, HTTP client, and Flue channel.",
  "workspaces": [
    "apps/gateway",
    "packages/client",
    "packages/flue"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "changeset:generate": "changeset",
    "changeset:apply": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^26.5.0",
    "concurrently": "^9.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "puppeteer": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
