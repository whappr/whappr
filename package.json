{
  "name": "whappr",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp gateway for AI agents.",
  "author": "Alexandru Bau (https://github.com/alexandrubau)",
  "license": "MIT",
  "workspaces": [
    "packages/protocol",
    "apps/gateway",
    "packages/client",
    "packages/flue"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "puppeteer": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
