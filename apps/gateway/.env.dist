# --- Required ---

# Shared secret. Signs outgoing webhook requests, gates POST /api/messages, and is typed into
# the UI to confirm logout. Generate with: openssl rand -hex 32
WHAPPR_SECRET=

# Inbound text messages are POSTed here.
WHAPPR_WEBHOOK_URL=

# --- Optional ---

# HTTP port. Default: 3000
PORT=3000

# Log verbosity. One of: fatal, error, warn, info, debug, trace, silent. Default: info
LOG_LEVEL=info

# Where whatsapp-web.js's LocalAuth persists the paired session, so you don't have to re-scan
# the QR code on every restart. Default: .wwebjs_auth
WWEB_SESSION_PATH=.wwebjs_auth

# Where whatsapp-web.js caches the WhatsApp Web version it last loaded, so a restart doesn't
# have to re-fetch it. Default: .wwebjs_cache
WWEB_CACHE_PATH=.wwebjs_cache

# How many seconds to buffer events before POSTing them as one batch. 0 sends each event
# immediately, with no buffering. Default: 2
WHAPPR_WEBHOOK_INTERVAL=2

# Filter which events get POSTed to the webhook (see README's "Filtering which events are sent"
# section). Unset, empty, or "*" all mean "send every event". Comma-separated entries; a bare
# "type" matches that type unconditionally, "type(field=value&field2=value2)" adds conditions,
# and an entry for a specific type always takes precedence over a "*" fallback listed alongside
# it (the wildcard is not consulted for a type that has its own entry). Default: * (every event)
# WHAPPR_EVENTS=msg.received(from=1555123456@c.us)
# WHAPPR_EVENTS=msg.received(from=1555123456@c.us),*

# Recognize inbound messages that start with "/" followed by one of these names as commands,
# producing a "cmd.invoked" event instead of "msg.received" for that message (see README's
# "Commands" section for the payload shape and how to restrict access via WHAPPR_EVENTS).
# Comma-separated command names; a name must not contain "/" or whitespace. Unset or empty means
# no commands are recognized — every message stays a plain "msg.received". Default: (none)
# WHAPPR_COMMANDS=start,help,subscribe
