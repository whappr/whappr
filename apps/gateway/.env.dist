# --- Required ---

# Shared secret. Callers send it as "Authorization: Bearer <SECRET_KEY>" on /api/*, the pairing
# page asks for it, and it signs outgoing webhook requests. At least 16 characters of letters,
# digits and ._~+/- . Generate with: openssl rand -hex 32
SECRET_KEY=

# Events (incoming messages, reactions, ...) are POSTed here, one per request.
WEBHOOK_URL=

# --- Optional ---

# HTTP port. Default: 3000
PORT=3000

# Log verbosity. One of: fatal, error, warn, info, debug, trace, silent. Default: info
LOG_LEVEL=info

# Where the paired session (auth/) and the WhatsApp Web version cache (cache/) are kept, so you
# don't have to re-scan the QR code on every restart. Default: data
DATA_DIR=data

# Comma-separated event types to POST to the webhook. Unset or empty means all of them:
# message.received, message.edited, message.deleted, reaction.added, reaction.removed.
# WEBHOOK_EVENTS=message.received

# Largest file, in megabytes, the gateway sends (POST /api/messages with media) or downloads
# (GET /api/messages/:id/media). Files pass through the browser in memory as base64, so very
# large ones can exhaust it. Webhooks only carry media metadata and aren't affected.
# Default: 64
MEDIA_MAX_SIZE=64
