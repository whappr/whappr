# --- Required ---

# Shared secret. Callers send it as "Authorization: Bearer <SECRET_KEY>" on /api/*, the pairing
# page asks for it, and it signs outgoing webhook requests. At least 16 characters of letters,
# digits and ._~+/- . Generate with: openssl rand -hex 32
SECRET_KEY=

# Events (incoming messages, reactions, ...) are POSTed here, one per request.
WEBHOOK_URL=

# --- Optional ---

# HTTP port. Default: 3000
PORT=3000

# Log verbosity. One of: fatal, error, warn, info, debug, trace, silent. Default: info
LOG_LEVEL=info

# Comma-separated event types to POST to the webhook. Unset or empty means all of them:
# message.received, message.edited, message.deleted, reaction.added, reaction.removed,
# group.joined, group.left, group.participant.joined, group.participant.left.
# FILTER_EVENT_TYPES=message.received

# Comma-separated chats to POST events for. Unset or empty means every chat. Each entry is a phone
# number in international format (40712345678), a direct chat id (…@c.us, …@lid) or a group chat id
# (…@g.us). Phone numbers and @c.us ids also match the chat when WhatsApp addresses it by @lid.
# Only affects webhooks: the API can still reach every chat.
# To find a chat id, run with LOG_LEVEL=debug: every event skipped for its chat is logged with its chatId.
# FILTER_CHAT_IDS=40712345678,120363012345678901@g.us

# Comma-separated senders to POST events for, in direct and group chats alike. Unset or empty means
# every sender. Each entry is a phone number in international format (40712345678) or a sender id
# (…@c.us, …@lid). Phone numbers and @c.us ids also match the sender when WhatsApp addresses them
# by @lid. Combined with FILTER_CHAT_IDS, an event must match both: a listed sender in a listed chat.
# Group events (group.*) have no sender and aren't affected.
# Only affects webhooks: the API can still reach every chat.
# To find a sender id, run with LOG_LEVEL=debug: every event skipped for its sender is logged with its senderId.
# FILTER_SENDER_IDS=40712345678,40787654321

# Largest file, in megabytes, the gateway sends (POST /api/messages with media) or downloads
# (GET /api/messages/:id/media). Files pass through the browser in memory as base64, so very
# large ones can exhaust it. Webhooks only carry media metadata and aren't affected.
# Default: 64
MEDIA_MAX_SIZE=64

# The name WhatsApp shows for the gateway under Linked devices, set when pairing. Unset or empty
# keeps whatsapp-web.js's default.
# DEVICE_NAME=Whappr
